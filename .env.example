# Copy to .env (never commit .env)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-32chars
JWT_SECRET_KEY=change-me-to-another-long-random-string
# SQLite for quick local dev. For PostgreSQL use:
# DATABASE_URL=postgresql://scms_user:scms_pass@localhost:5432/scms
DATABASE_URL=sqlite:///scms_dev.db
UPLOAD_FOLDER=uploads
